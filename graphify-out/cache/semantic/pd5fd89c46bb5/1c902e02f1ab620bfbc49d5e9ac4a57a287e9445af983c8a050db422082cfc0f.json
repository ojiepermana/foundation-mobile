{"nodes": [{"id": "docs_scope_index", "label": "Mobile foundation scope (index)", "file_type": "document", "source_file": "docs/scope/index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_scope_index_tracer_bullet_build_approach", "label": "Tracer Bullet build approach", "file_type": "rationale", "source_file": "docs/scope/index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A shared change follows one working path from the core to both apps, so the greeting is traced from its owner through both screens and the checks that run when the repository changes."}, {"id": "docs_scope_index_beta_workflow", "label": "Beta workflow (/check verify, then /test)", "file_type": "rationale", "source_file": "docs/scope/index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "After a change, /check verify runs on the affected apps and /test on the affected contracts; a new ownership or contract decision belongs in the design stage."}, {"id": "docs_scope_index_deferred_work", "label": "Deferred work beyond Hello World", "file_type": "concept", "source_file": "docs/scope/index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The foundation ends at Hello World; three pieces of work that stay close to the greeting are listed so the plan stays honest. Everything else (accounts, backend clients, storage, sync, navigation, component library, desktop) needs its own product brief and scope."}, {"id": "docs_scope_index_deferred_contract_beyond_one_string", "label": "Deferred: a contract beyond one string (record, typed error, async call)", "file_type": "concept", "source_file": "docs/scope/index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The repository rules ask for a real caller first, so the first product feature is the place to prove records, typed errors and async calls. Needs a decision."}, {"id": "docs_scope_index_deferred_second_language_end_to_end", "label": "Deferred: a second language end to end", "file_type": "concept", "source_file": "docs/scope/index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The core forms the greeting sentence in English, so where the sentence shape lives must be decided before a second catalog can run in both apps. Needs a decision."}, {"id": "docs_scope_index_deferred_signing_device_runs_store_delivery", "label": "Deferred: signing, physical device runs and store delivery", "file_type": "concept", "source_file": "docs/scope/index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A signed build on real hardware and a path to the stores is out of the Hello World foundation. Needs a decision."}, {"id": "docs_scope_index_scope_status_legend", "label": "Scope status legend and file numbering convention", "file_type": "concept", "source_file": "docs/scope/index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "'existing' means the capability shipped before this scope; 'done' means the planned outcome has been verified; the first open box is the suggested next step. Each workspace numbers its scope files independently from 001."}, {"id": "docs_scope_index_hosted_run_43593365100", "label": "Hosted run 43593365100 on commit 6587579 (all three jobs passed)", "file_type": "concept", "source_file": "docs/scope/index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "url": "https://github.com/ojiepermana/foundation-mobile/actions/runs/43593365100"}], "edges": [{"source": "docs_scope_index", "