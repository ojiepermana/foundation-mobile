{"nodes": [{"id": "docs_decisions_adr_0001_foundation", "label": "ADR 0001: Native apps with a shared Rust core", "file_type": "document", "source_file": "docs/decisions/ADR-0001-foundation.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_adr_0001_foundation_shared_rust_core_decision", "label": "Decision: two Cargo workspace members; dependency-free core exported through UniFFI to native apps", "file_type": "rationale", "source_file": "docs/decisions/ADR-0001-foundation.md", "source_location": "L9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The product needs independently native Apple and Android presentations with one implementation of shared behavior. Keeping contract types separate from the implementation lets the core evolve without leaking internal types; cost is that an API change touches the export, both binding snapshots and both app verification paths."}, {"id": "docs_decisions_adr_0001_foundation_neutral_json_sources", "label": "Decision: neutral JSON tokens and validated shared sources generate native theme inputs and localization", "file_type": "rationale", "source_file": "docs/decisions/ADR-0001-foundation.md", "source_location": "L13", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One shared visual vocabulary; visual and copy changes can ship through resource generation without touching Rust, while appearance and type scaling are applied per platform."}, {"id": "docs_decisions_adr_0001_foundation_checked_in_source_snapshots", "label": "Decision: keep generated source snapshots in version control and compare against fresh regeneration", "file_type": "rationale", "source_file": "docs/decisions/ADR-0001-foundation.md", "source_location": "L15", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Xcode and Gradle compile a reviewed contract directly; verification regenerates in a fresh directory and compares, while target binaries and SDK installations are ignored."}, {"id": "docs_decisions_adr_0001_foundation_rejected_shared_ui_runtime", "label": "Rejected alternative: shared UI runtime", "file_type": "rationale", "source_file": "docs/decisions/ADR-0001-foundation.md", "source_location": "L21", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A shared UI runtime would move control of navigation and rendering away from the native frameworks."}, {"id": "docs_decisions_adr_0001_foundation_rejected_duplicated_behavior", "label": "Rejected alternative: implementing application behavior independently in both apps", "file_type": "rationale", "source_file": "docs/decisions/ADR-0001-foundation.md", "source_location": "L21", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Duplicated behavior would create two places to change a rule; the chosen boundaries keep one behavioral owner."}, {"id": "docs_decisions_adr_0001_foundation_revisit_conditions", "label": "Revisit conditions: dependency direction change, async native boundary, independently versioned clients, new shared crate or service", "file_type": "concept", "source_file": "docs/decisions/ADR-0001-foundation.md", "source_location": "L23", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_adr_0001_foundation_single_greeting_scope", "label": "Single greeting as the minimal exercise of interop, linking, resources and display", "file_type": "rationale", "source_file": "docs/decisions/ADR-0001-foundation.md", "source_location": "L7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One greeting is enough to prove language interoperability, linking, resources and display before committing to additional services."}], "edges": [{"source": "docs_decisions_adr_0001_foundation", "target": 