{"nodes": [{"id": "agents", "label": "AGENTS.md: Working in the mobile foundation", "file_type": "document", "source_file": "AGENTS.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_before_editing", "label": "Agent workflow: before editing (locate owner, contract, callers, tests)", "file_type": "document", "source_file": "AGENTS.md", "source_location": "L3-L5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Inspect the checkout and search both apps and the shared sources first so an existing owner or implementation is reused; the dependency rules identify permitted edges and the quality checks decide which verification applies."}, {"id": "agents_during_implementation", "label": "Agent workflow: during implementation (place change in owning layer)", "file_type": "document", "source_file": "AGENTS.md", "source_location": "L7-L12", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shared behavior belongs in crates/core and mobile APIs change at the UniFFI boundary so both native clients stay on the same contract; presentation and OS integration stay in the owning app; a new capability needs a plan and a material ownership, contract or dependency decision needs an ADR, with affected architecture documents updated in the same change."}, {"id": "agents_before_handoff", "label": "Agent workflow: before handoff (run checks, report commands and unverified targets)", "file_type": "document", "source_file": "AGENTS.md", "source_location": "L14-L16", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A contract change must be verified on both clients; the handoff carries exact commands, target/toolchain, observed result and any unverified target so the receiver knows what was and was not proven."}, {"id": "agents_before_commit", "label": "Agent workflow: before commit (run /graphify . --update, stage graphify-out with the change)", "file_type": "document", "source_file": "AGENTS.md", "source_location": "L18-L20", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Updating the graph before committing makes the knowledge graph cover every file the change adds, edits or deletes; staging the tracked graphify-out files into the same commit keeps the graph and the change in one revision."}, {"id": "agents_never_hand_edit_generated_files", "label": "Never hand-edit generated files", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": "L11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shared visual values, copy, configuration and brand sources are changed at their canonical source (tokens, shared resources) and their native outputs are regenerated, so generated files are never edited by hand."}, {"id": "agents_knowledge_graph", "label": "Knowledge graph (graphify-out/, kept current with /graphify . --update)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "L20", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The tracked files under graphify-out/ are committed together with the change they describe, so the graph always reflects the files added, edited or deleted by that commit."}], "edges": [{"source": "agents", "target": "agents_before_editing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENTS.md", "source_location": "L3", "weight": 1.0}, {"source": "agents", "target": "agents_during_implementation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENTS.md", "source_location": "L7", "weight": 1.0}, {"source": "agents", "target": "agents_before_handoff", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENTS.md", "source_location"