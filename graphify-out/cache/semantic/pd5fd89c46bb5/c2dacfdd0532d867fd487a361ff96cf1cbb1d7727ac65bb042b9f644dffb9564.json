on": null, "source_url": null, "_origin": "semantic"}, {"id": "docs_design_system_token_conventions_role_stability", "label": "Stable role names or same-change migration", "author": null, "captured_at": null, "contributor": null, "file_type": "rationale", "rationale": "Existing role names stay stable across both apps, or their uses are migrated in the same change; schema changes accompany new token categories or required roles.", "source_file": "docs/design-system/token-conventions.md", "source_location": null, "source_url": null, "_origin": "semantic"}, {"id": "docs_design_system_token_conventions_typography_scale", "label": "Typography scale in logical text units", "author": null, "captured_at": null, "contributor": null, "file_type": "rationale", "rationale": "A scale name identifies typographic intent with size and line height at the default user text setting; platform adapters map that intent to native scaling behavior.", "source_file": "docs/design-system/token-conventions.md", "source_location": null, "source_url": null, "_origin": "semantic"}, {"id": "docs_design_system_token_conventions_canonical_token_sources", "label": "Canonical token sources (colors, typography, spacing, radius, motion JSON)", "author": null, "captured_at": null, "contributor": null, "file_type": "concept", "source_file": "docs/design-system/token-conventions.md", "source_location": null, "source_url": null, "_origin": "semantic"}, {"id": "docs_design_system_token_conventions_required_roles_and_naming_rule", "label": "Required roles and naming rule: the schema requires a fixed set of roles (eleven color roles, heading and body for typography, page and content for spacing, surface for radius, feedback for motion); heading is the most prominent line of text on a screen and body is running text", "file_type": "rationale", "source_file": "docs/design-system/token-conventions.md", "source_location": "L15", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A fixed set of required roles lets both apps rely on them. Each role is named for where it is used, so a new role is named the same way, never after the screen or the sample that uses it first.", "_origin": "semantic"}], "edges": [{"source": "docs_design_system_token_conventions_canonical_token_sources", "target": "docs_design_system_token_conventions_primitive_token", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/design-system/token-conventions.md", "source_location": null, "weight": 1.0, "_origin": "semantic"}, {"source": "docs_design_system_token_conventions_canonical_token_sources", "target": "docs_design_system_token_conventions_semantic_role", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/design-system/token-conventions.md", "source_location": null, "weight": 1.0, "_origin": "semantic"}, {"source": "docs_design_system_token_conventions", "target": "design_system_schemas_tokens_schema", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/design-system/token-conventions.md", "source_location": null, "weight": 1.0, "_origin": "semantic"}, {"source": "docs_design_system_token_conventions", "target": "docs_design_system_token_conventions_canonical_token_sources", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/design-system/token-conventions.md", "source_location": null, "weight": 1.0, "_origin": "semantic"}, {"source": "docs_design_system_token_conventions", "target": "docs_design_system_token_conventions_local_primitive_references", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/design-system/token-conventions.md", "source_location": null, "weight": 1.0, "_origin": "semantic"}, {"source": "docs_design_system_token_conventions", "target": "docs_design_system_token_conventions_namin