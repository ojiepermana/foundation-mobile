{"nodes": [{"id": "github_workflows_foundation", "label": "Mobile foundation CI workflow", "file_type": "code", "source_file": ".github/workflows/foundation.yml", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "github_workflows_foundation_android_job", "label": "CI job: android (JDK 17, API 36 emulator, optional sample derivation, identity comparison, Kotlin binding + Compose UI)", "file_type": "code", "source_file": ".github/workflows/foundation.yml", "source_location": "L74", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "github_workflows_foundation_ios_job", "label": "CI job: ios (macos-26, Xcode 26.5, optional sample derivation, simulator build, identity comparison, unsigned device link, greeting in light and dark)", "file_type": "code", "source_file": ".github/workflows/foundation.yml", "source_location": "L29", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "github_workflows_foundation_appearance_verification", "label": "Light and dark appearance verification in CI", "file_type": "rationale", "source_file": ".github/workflows/foundation.yml", "source_location": "L62", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each system appearance is set, the simulator is rebooted and the appearance re-read before the UI test runs, so both generated palettes are proven from independent boots; Android repeats the instrumentation suite with night mode off and on."}, {"id": "github_workflows_foundation_foundation_job", "label": "CI job: foundation (locked Rust build + scripts/test.sh on ubuntu-24.04)", "file_type": "code", "source_file": ".github/workflows/foundation.yml", "source_location": "L17", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "github_workflows_foundation_pinned_actions", "label": "SHA-pinned GitHub Actions with read-only contents permission", "file_type": "rationale", "source_file": ".github/workflows/foundation.yml", "source_location": "L13", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Third-party actions are pinned to commit SHAs and the workflow only requests contents: read, limiting supply-chain exposure."}, {"id": "github_workflows_foundation_derived_input", "label": "workflow_dispatch input derived (boolean, default false): build and test both apps under a sample product identity", "file_type": "code", "source_file": ".github/workflows/foundation.yml", "source_location": "L7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "github_workflows_foundation_derive_sample_product_step", "label": "CI step: Derive a sample product from this checkout (only when inputs.derived; init-project.sh --check, then --name \"Zo\u00eb's Proof\" --app-id dev.example.derived when the state is foundation)", "file_type": "code", "source_file": ".github/workflows/foundation.yml", "source_location": "L37", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The proof is for the foundation repository only: when --check does not print foundation the step prints the state instead of deriving, so a derived product that runs the workflow is never derived again."}, {"id": "github_workflows_foundation_ios_identity_comparison_step", "label": "CI step (ios): Compare the built app with the identity file (APP_BUNDLE_IDENTIFIER and APP_DISPLAY_NAME in Identity.xcconfig against CFBundleIdentifier and CFBundleDisplayName read with PlistBuddy)", "file_type": "code", "source_file": ".github/workflows/foundation.yml", "source_location": "L48", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs in every run with no condition and fails on an empty expected value or any difference, so a build that ignores the identity file cannot pass."}, {"id": "github_workflows_foundation_android_identity_comparison_step", "label": "CI step (android): Compare the built app with the identity file (applicationId and displayName in identity.properties against package name and application-label from aapt2 dump badging on the debug APK)", "file_type": "code", "source_file": ".github/workflows/foundation.yml", "source_location": "L100", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs in every run with no condition and fails on an empty expected value or any difference, so a build that ignores the identity file cannot pass."}], "edges": [{"source": "github_workflows_foundation_android_job", "target": "github_workflows_foundation_appearance_verification", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/foundation.yml", "source_location": "L121", "weight": 1.0}, {"source": "github_workflows_foundation_ios_job", "target": "github_workflows_foundation_appearance_verification", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/foundation.yml", "source_location": "L62", "weight": 1.0}, {"source": "github_workflows_foundation_pinned_actions", "target": "github_workflows_foundation", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/foundation.yml", "source_location": "L13", "weight": 1.0}, {"source": "github_workflows_foundation_android_job", "target": "scripts_build_android", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/foundation.yml", "source_location": "L99", "weight": 1.0}, {"source": "github_workflows_foundation_foundation_job", "target": "scripts_test", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/foundation.yml", "source_location": "L27", "weight": 1.0}, {"source": "github_workf