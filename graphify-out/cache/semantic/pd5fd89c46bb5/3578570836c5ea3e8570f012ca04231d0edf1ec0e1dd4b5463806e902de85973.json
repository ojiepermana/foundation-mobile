{"nodes": [{"id": "claude_skills_coordinate_skill", "label": "/coordinate skill: finish one scope with parallel sub-sessions (architect, developer, checker, tester, debugger) while the invoking session acts as lead", "file_type": "document", "source_file": ".claude/skills/coordinate/SKILL.md", "source_location": "L8", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_coordinate_skill_lead", "label": "Lead session: stays on main in the main checkout, picks the SCOPE, splits items, guards the tick gates, merges green branches and writes the log; writes no production code", "file_type": "concept", "source_file": ".claude/skills/coordinate/SKILL.md", "source_location": "L10", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_coordinate_skill_sub_session", "label": "Sub-session: a linked app session with its own worktree and branch that runs one item of the flow and receives only its brief, not the lead's history", "file_type": "concept", "source_file": ".claude/skills/coordinate/SKILL.md", "source_location": "L10", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_coordinate_skill_run_defaults", "label": "Run defaults of /coordinate: parallel sub-sessions for non-overlapping ownership, wave plan shown then run, debugger on a red gate, decisions follow the decision mode, user-only steps go to the manual file, a feature is marked done at its last box", "file_type": "concept", "source_file": ".claude/skills/coordinate/SKILL.md", "source_location": "L24", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_coordinate_skill_step_1_determine_scope", "label": "Lead step 1: determine the SCOPE (lead on main, skill folder committed, lead model Fable, argument split into scope, mode word and extra conditions, create the brief-umum and manual files, resume from an existing log)", "file_type": "concept", "source_file": ".claude/skills/coordinate/SKILL.md", "source_location": "L53", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_coordinate_skill_step_2_analysis_and_wave_plan", "label": "Lead step 2: analysis and wave plan (read the scope and the needed spec parts, reconcile with sessions, branches and code already on main, build the dependency graph, mark each open box SIAP or TERBLOKIR)", "file_type": "concept", "source_file": ".claude/skills/coordinate/SKILL.md", "source_location": "L66", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_coordinate_skill_item_and_ownership", "label": "Item and ownership: one item is one box or part of a milestone's Build plan steps; ownership is written as file paths, and two items share a wave only when no file is in both ownerships", "file_type": "concept", "source_file": ".claude/skills/coordinate/SKILL.md", "source_location": "L79", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_coordinate_skill_wave_plan_queue", "label": "Wave plan: an ordered queue approved once (longest remaining chain first, then items whose merge unblocks most, closing boxes, architects as slot fillers), shown and then run without waiting", "file_type": "concept", "source_file": ".claude/skills/coordinate/SKILL.md", "source_location": "L81", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_coordinate_skill_step_3_start_sub_sessions", "label": "Lead step 3: start sub-sessions from the head of the queue with start_session, at most 4 running at once, named <role>-f<feature>-<item>, with the filled brief as prompt and model and effort always set", "file_type": "concept", "source_file": ".claude/skills/coordinate/SKILL.md", "source_location": "L83", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_coordinate_skill_standby_first_turn", "label": "Standby first turn: all sessions the queue needs are started on the user's turn; reserve sessions and sessions whose item is not ready end their first turn with STATUS: standby until the lead sends start", "file_type": "concept", "source_file": ".claude/skills/coordinate/SKILL.md", "source_location": "L87", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_coordinate_skill_model_per_role", "label": "Model per role: Fable for decisions, judgement and root cause (architect, checker, debugger), Opus for building and writing tests from a decided spec (developer, tester); Sonnet and Haiku are not used", "file_type": "concept", "source_file": ".claude/skills/coordinate/SKILL.md", "source_location": "L91", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_coordinate_skill_reviewer_model_rule", "label": "Reviewer rule: the reviewer must be a different model family from every author in the change range", "file_type": "rationale", "source_file": ".claude/skills/coordinate/SKILL.md", "source_location": "L104", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_coordinate_skill_step_4_communication", "label": "Lead step 4: communication (sub-sessions message each other directly through SendMessage, changes outside ownership are requested from the file owner, deviations go to the lead, one final report per item)", "file_type": "concept", "source_file": ".claude/skills/coordinate/SKILL.md", "source_location": "L106", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_coordinate_skill_step_5_reports", "label": "Lead step 5: reports (recap starts with STATUS, the full report follows the report template, done is valid only when committed with a clean tree, the lead checks the branch diff before trusting a report)", "file_type": "concept", "source_file": ".claude/skills/coordinate/SKILL.md", "source_location": "L110", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_coordinate_skill_step_6_tick_gate_and_merge", "label": "Lead step 6: tick gate and merge (only the lead edits scope files; clean worktree, diff limited to ownership, merge --no-ff --no-commit, checks on main, commit, then tick one box per edit)", "file_type": "concept", "source_file": ".claude/skills/coordinate/SKILL.md", "source_location": "L114", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_coordinate_skill_red_gate_cycle", "label": "Red gate cycle: red from fmt, clippy or out-of-ownership files goes back to the developer for one round; red from a test or verify step aborts the merge and starts a debugger; the box stays open until green", "file_type": "concept", "source_file": ".claude/skills/coordinate/SKILL.md", "source_location": "L116", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_coordinate_skill_gate_design_it", "label": "Gate Design it (spec): spec accepted per decision mode, architect branch merged, spec has Requirements with AC IDs, Decision, Build plan and Consequences; the lead then adds the Pointer line and milestones to the scope", "file_type": "concept", "source_file": ".claude/skills/coordinate/SKILL.md", "source_location": "L118", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_coordinate_skill_gate_milestone", "label": "Gate milestone: developer branch merged and the checker verify reports done for that milestone's section of verify.md", "file_type": "concept", "source_file": ".claude/skills/coordinate/SKILL.md", "source_location": "L119", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_coordinate_skill_gate_build_it_and_verify_it", "label": "Gate Build it and Verify it: closed together by one checker running a full /check verify after the last milestone is merged", "file_type": "concept", "source_file": ".claude/skills/coordinate/SKILL.md", "source_location": "L120", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_coordinate_skill_gate_test_it", "label": "Gate Test it: tester report done, branch merged, evidence check passes on main; may run alongside Verify it", "file_type": "concept", "source_file": ".claude/skills/coordinate/SKILL.md", "source_location": "L121", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_coordinate_skill_gate_review_it", "label": "Gate Review it (GA features): review by a new checker session that has not seen the implementation, file in docs/reviews; Blocker or Major findings start a fix item; ticked when none remain open", "file_type": "concept", "source_file": ".claude/skills/coordinate/SKILL.md", "source_location": "L122", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_coordinate_skill_gate_document_it", "label": "Gate Document it: the lead runs the document skill with changelog over the feature's merge range and commits CHANGELOG.md", "file_type": "concept", "source_file": ".claude/skills/coordinate/SKILL.md", "source_location": "L123", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_coordinate_skill_step_7_log", "label": "Lead step 7: log (update the coordination log after every report and commit scope edits and the log right after each tick, before the next merge and before starting a new sub-session)", "file_type": "concept", "source_file": ".claude/skills/coordinate/SKILL.md", "source_location": "L126", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_coordinate_skill_step_8_end_of_wave", "label": "Lead step 8: end of wave (summary led by heavy delegated decisions and new manual steps, run sync over the wave range, record the next wave's start hash)", "file_type": "concept", "source_file": ".claude/skills/coordinate/SKILL.md", "source_location": "L130", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_coordinate_skill_step_9_closing", "label": "Lead step 9: closing (merge every green branch, run /sync, commit, push main without force, archive sessions and remove worktrees and branches that pass the three cleanup checks)", "file_type": "concept", "source_file": ".claude/skills/coordinate/SKILL.md", "source_location": "L134", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_coordinate_skill_decision_mode", "label": "Decision mode (Mode keputusan): governs only decisions, the choices that change spec content; an ambiguous AC reading is not a decision", "file_type": "concept", "source_file": ".claude/skills/coordinate/SKILL.md", "source_location": "L154", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_coordinate_skill_heavy_decision", "label": "Heavy decision (keputusan berat): expensive to reverse once built (on-disk data format or migration, contract break, security model, licensing, existing user data, changes to an Accepted spec)", "file_type": "concept", "source_file": ".claude/skills/coordinate/SKILL.md", "source_location": "L158", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_coordinate_skill_mode_auto", "label": "Mode auto (default): the recommended option is taken for ordinary and heavy decisions, heavy ones flagged berat", "file_type": "concept", "source_file": ".claude/skills/coordinate/SKILL.md", "source_location": "L162", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_coordinate_skill_mode_tanya_berat", "label": "Mode tanya berat: the recommended option for ordinary decisions, the user decides heavy ones", "file_type": "concept", "source_file": ".claude/skills/coordinate/SKILL.md", "source_location": "L163", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_coordinate_skill_mode_tanya", "label": "Mode tanya: the user decides every decision", "file_type": "concept", "source_file": ".claude/skills/coordinate/SKILL.md", "source_location": "L164", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_coordinate_skill_recommended_option", "label": "Recommended option: the architect takes its own recommendation and writes reason and runner-up in rationale.md; the lead accepts after three checks; every decision is recorded with its runner-up and how to undo it", "file_type": "concept", "source_file": ".claude/skills/coordinate/SKILL.md", "source_location": "L168", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_coordinate_skill_values_only_the_user_knows", "label": "Values only the user knows (email address, account, handle, legal name, price) are not decisions in any mode: they go to the manual file and the dependent AC is BLOCKED with owner user", "file_type": "concept", "source_file": ".claude/skills/coordinate/SKILL.md", "source_location": "L172", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_coordinate_skill_manual_steps", "label": "Manual steps (Langkah manual): steps needing the user's eyes, hands, account, device or permission; no session runs them; the box is still ticked when the rest passes and the step is recorded NOT_RUN; a FAIL reopens it", "file_type": "concept", "source_file": ".claude/skills/coordinate/SKILL.md", "source_location": "L176", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_coordinate_skill_limits", "label": "Limits (Batasan): only the lead edits scope files and merges to main; the lead pushes main only in step 9 and never with force; sub-sessions commit on their own branch and never push or open a PR; some choices always wait for the user", "file_type": "concept", "source_file": ".claude/skills/coordinate/SKILL.md", "source_location": "L185", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_coordinate_skill_graph_only_for_changed_files", "label": "Token saving: graph only for changed files: each graph update processes only the files of the commit being prepared; code through graphify update, documents through a restricted /graphify --update whose manifest is stamped for those files only", "file_type": "rationale", "source_file": ".claude/skills/coordinate/SKILL.md", "source_location": "L195", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_coordinate_skill_graph_first_then_files", "label": "Token saving: graph first, files later: lead and sub-sessions ask graphify query and explain before reading files, and open files only where the graph points", "file_type": "rationale", "source_file": ".claude/skills/coordinate/SKILL.md", "source_location": "L196", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_coordinate_skill_reuse_sub_sessions", "label": "Token saving: reuse a finished sub-session for the next item of the same feature after clearing its context; never for Review it", "file_type": "rationale", "source_file": ".claude/skills/coordinate/SKILL.md", "source_location": "L197", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "claude_skills_coordinate_skill", "target": "claude_skills_coordinate_skill_lead", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/coordinate/SKILL.md